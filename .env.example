GATEWAY_PORT=8080
POSTGRES_PASSWORD=replace-with-a-strong-random-password
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://gateway:replace-with-a-strong-random-password@postgres:5432/gateway
DATABASE_POOL_MAX=20
MASTER_ENCRYPTION_KEY=
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=change-this-immediately
SESSION_SECRET=change-this-to-a-long-random-secret
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
TRUST_PROXY=false
MAX_BODY_BYTES=10485760
REQUEST_TIMEOUT_MS=120000
STREAM_IDLE_TIMEOUT_MS=30000
DEFAULT_RATE_LIMIT_RPM=120
DEFAULT_MONTHLY_SPEND_USD=100
CONTENT_LOGGING=false
METADATA_RETENTION_DAYS=90
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
